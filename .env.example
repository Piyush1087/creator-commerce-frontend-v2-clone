# Leave unset in local dev to use Vite `/api` proxy (same-origin, no CORS).
# Socket.IO still connects to http://localhost:3000 — run backend-v2 (`npm run dev`) for collaborations realtime.
# Set when the API runs on another host, e.g. https://api.dev.example.com
# VITE_API_URL=http://localhost:3000
VITE_STAGE=local
